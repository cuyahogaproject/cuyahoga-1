<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Cuyahoga.Core</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Castle.Core" Version="3.2.0" />
    <PackageReference Include="Castle.Windsor" Version="3.2.1" />
    <PackageReference Include="Iesi.Collections" Version="3.2.0.1001" />
    <PackageReference Include="log4net" Version="1.2.10" />
    <PackageReference Include="NHibernate" Version="3.3.3.4001" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Castle.Facilities.AutoTx" HintPath="$(CuyahogaLibDir)Castle.Facilities.AutoTx.dll" />
    <Reference Include="Castle.Facilities.NHibernateIntegration" HintPath="$(CuyahogaLibDir)Castle.Facilities.NHibernateIntegration.dll" />
    <Reference Include="Castle.Services.Transaction" HintPath="$(CuyahogaLibDir)Castle.Services.Transaction.dll" />
    <Reference Include="Lucene.Net" HintPath="$(CuyahogaLibDir)Lucene.Net.dll" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
