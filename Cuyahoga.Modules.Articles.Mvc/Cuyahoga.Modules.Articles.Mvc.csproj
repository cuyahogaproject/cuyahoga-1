<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
  The Articles module on the public pages of the ASP.NET Core site (Web.Core): the list of articles and an article with
  its comments (view component), posting a comment (controller), the admin pages (Pages/Modules/Articles) and the
  texts (Resources).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Articles.Mvc</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web.Mvc\Cuyahoga.Web.Mvc.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Articles\Cuyahoga.Modules.Articles.csproj" />
  </ItemGroup>
</Project>
