<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
  The Articles module on the public pages of the ASP.NET Core site (Web.Core): the list of articles and an article with
  its comments (view component), and posting a comment (controller). Its WebForms controls and admin pages are in
  Cuyahoga.Modules.Articles.Web.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Articles.Mvc</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web.Mvc\Cuyahoga.Web.Mvc.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Articles\Cuyahoga.Modules.Articles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The texts (and translations) of the WebForms controls, shared until those are gone. -->
    <EmbeddedResource Include="..\Cuyahoga.Modules.Articles.Web\Resources\Strings*.resx" Link="Resources\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
