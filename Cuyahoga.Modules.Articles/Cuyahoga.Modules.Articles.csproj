<Project Sdk="Microsoft.NET.Sdk">
  <!--
  The Articles module: the module class, the domain, data access and the NHibernate mappings. netstandard2.0, so the
  WebForms site and the ASP.NET Core site (Web.Core) both load it. Its views and admin pages are in
  Cuyahoga.Modules.Articles.Mvc.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Articles</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
    <CuyahogaModuleFile Include="Install\Database\**\*.sql" DeployTo="Modules\Articles\Install\Database\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
  </ItemGroup>
</Project>
