<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
  The Downloads module on the public pages of the ASP.NET Core site (Web.Core): the list of files (view component) and
  the downloads (controller), the admin pages (Pages/Modules/Downloads) and the texts (Resources).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Downloads.Mvc</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web.Mvc\Cuyahoga.Web.Mvc.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Downloads\Cuyahoga.Modules.Downloads.csproj" />
  </ItemGroup>
</Project>
