<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Flash</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
    <CuyahogaModuleFile Include="Web\**\*.as?x;Web\**\*.gif;Web\**\*.css" DeployTo="Modules\Flash\" />
    <CuyahogaModuleFile Include="Install\Database\**\*.sql" DeployTo="Modules\Flash\Install\Database\" />
    <CuyahogaBinFile Include="lib\Xylem.Controls.FlashMovieControl.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
    <ProjectReference Include="..\Web\Cuyahoga.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Xylem.Controls.FlashMovieControl" HintPath="lib\Xylem.Controls.FlashMovieControl.dll" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
