<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Forum</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
    <CuyahogaModuleFile Include="Web\**\*.as?x;Web\**\*.gif;Web\**\*.css;Web\**\*.js" DeployTo="Modules\Forum\" />
    <CuyahogaModuleFile Include="Install\Database\**\*.sql" DeployTo="Modules\Forum\Install\Database\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
    <ProjectReference Include="..\ServerControls\Cuyahoga.ServerControls.csproj" />
    <ProjectReference Include="..\Web\Cuyahoga.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Castle.Facilities.AutoTx" HintPath="$(CuyahogaLibDir)Castle.Facilities.AutoTx.dll" />
    <Reference Include="Castle.Facilities.NHibernateIntegration" HintPath="$(CuyahogaLibDir)Castle.Facilities.NHibernateIntegration.dll" />
    <Reference Include="Castle.Services.Transaction" HintPath="$(CuyahogaLibDir)Castle.Services.Transaction.dll" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
