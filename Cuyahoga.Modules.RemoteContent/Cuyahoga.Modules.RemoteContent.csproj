<Project Sdk="Microsoft.NET.Sdk">
  <!--
  The RemoteContent module: the module class, the domain and the NHibernate mappings. netstandard2.0, so the WebForms
  site and the ASP.NET Core site (Web.Core) both load it. Its views and admin pages are in
  Cuyahoga.Modules.RemoteContent.Mvc.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.RemoteContent</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
    <CuyahogaModuleFile Include="Install\Database\**\*.sql" DeployTo="Modules\RemoteContent\Install\Database\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
  </ItemGroup>
</Project>
