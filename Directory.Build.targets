<Project>
  <!--
  Deploys the files of a module project into the site (Web.Core) after each build: CuyahogaModuleFile items (install
  scripts, e-mail templates, images) are copied to Web.Core\%(DeployTo)%(RecursiveDir). The site serves the images of
  the modules (Modules/*/Images) and reads the rest (Program.cs). A project opts in by setting the CuyahogaModule
  property to true.
  -->
  <Target Name="DeployCuyahogaModule" AfterTargets="Build" Condition="'$(CuyahogaModule)' == 'true'">
    <Copy SourceFiles="@(CuyahogaModuleFile)"
          DestinationFiles="@(CuyahogaModuleFile->'$(CuyahogaSiteDir)%(DeployTo)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
