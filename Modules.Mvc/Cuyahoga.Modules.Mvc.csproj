<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
  The views of the built-in modules (Cuyahoga.Modules) on the public pages of the ASP.NET Core site (Web.Core): one
  ModuleViewComponent per module, with its views in Modules/{Module}/, and the admin pages in Pages/Modules/{Module}/.
  The texts of a module are in {Module}/Resources/Strings*.resx, the resources {namespace of the view
  component}.Resources.Strings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules.Mvc</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web.Mvc\Cuyahoga.Web.Mvc.csproj" />
    <ProjectReference Include="..\Modules\Cuyahoga.Modules.csproj" />
  </ItemGroup>
</Project>
