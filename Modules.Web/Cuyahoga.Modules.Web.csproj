<Project Sdk="Microsoft.NET.Sdk">
  <!--
  The WebForms controls of the built-in modules (Cuyahoga.Modules). The folders and the root namespace match the
  module classes, so the markup (Inherits="Cuyahoga.Modules.StaticHtml.StaticHtml") and the resource names
  (Cuyahoga.Modules.Search.Resources.Strings) are the same as before the split.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Cuyahoga.Modules</RootNamespace>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <CuyahogaModuleFile Include="**\*.as?x;**\*.gif;**\*.png;**\*.txt" Exclude="bin\**;obj\**" DeployTo="Modules\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
    <ProjectReference Include="..\Modules\Cuyahoga.Modules.csproj" />
    <ProjectReference Include="..\ServerControls\Cuyahoga.ServerControls.csproj" />
    <ProjectReference Include="..\Web\Cuyahoga.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
