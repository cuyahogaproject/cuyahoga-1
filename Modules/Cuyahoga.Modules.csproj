<Project Sdk="Microsoft.NET.Sdk">
  <!-- The built-in modules (StaticHtml, User, Search, Sitemap, LanguageSwitcher). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Cuyahoga.Modules</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
    <CuyahogaModuleFile Include="**\*.as?x;**\*.gif;**\*.png;**\*.txt" Exclude="bin\**;obj\**" DeployTo="Modules\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
    <ProjectReference Include="..\ServerControls\Cuyahoga.ServerControls.csproj" />
    <ProjectReference Include="..\Web\Cuyahoga.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
