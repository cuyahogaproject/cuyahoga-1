<Project Sdk="Microsoft.NET.Sdk">
  <!--
  The built-in modules (StaticHtml, User, Search, Sitemap, LanguageSwitcher) without their WebForms controls (those
  are in Cuyahoga.Modules.Web): the module classes and the NHibernate mappings. netstandard2.0, so the WebForms site
  and the ASP.NET Core site (Web.Core) both load it.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Cuyahoga.Modules</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CuyahogaModule>true</CuyahogaModule>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.hbm.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
  </ItemGroup>
</Project>
