<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Runs the netstandard2.0 build of Core on .NET Framework (like the web site) and on .NET 10. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cuyahoga.Core.Tests</RootNamespace>
    <!-- dotnet test (.NET 10 SDK) uses Microsoft.Testing.Platform, see global.json. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Also brings System.Configuration (ConfigurationManager package) on both targets. -->
    <ProjectReference Include="..\..\Core\Cuyahoga.Core.csproj" />
  </ItemGroup>
</Project>
