<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
  The Cuyahoga site: the public pages, the site administration, the installer. Public files are in wwwroot, the install
  scripts in Install, the files of the modules in Modules (deployed there by the builds of the modules), the data of the
  site in the data folder (DataPath, App_Data by default).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cuyahoga.Web.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5e7767ba-ef08-4439-a7bd-683121133326</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
    <!--
    The module classes, so the admin pages can use the modules: module settings, connections, deleting module content.
    The modules are activated from the database (ModuleActivation).
    -->
    <ProjectReference Include="..\Modules\Cuyahoga.Modules.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Articles\Cuyahoga.Modules.Articles.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Downloads\Cuyahoga.Modules.Downloads.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.RemoteContent\Cuyahoga.Modules.RemoteContent.csproj" />
    <!-- The public pages: what modules build their views on, and the views of the modules. -->
    <ProjectReference Include="..\Web.Mvc\Cuyahoga.Web.Mvc.csproj" />
    <ProjectReference Include="..\Modules.Mvc\Cuyahoga.Modules.Mvc.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Downloads.Mvc\Cuyahoga.Modules.Downloads.Mvc.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.Articles.Mvc\Cuyahoga.Modules.Articles.Mvc.csproj" />
    <ProjectReference Include="..\Cuyahoga.Modules.RemoteContent.Mvc\Cuyahoga.Modules.RemoteContent.Mvc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
    Database drivers, loaded by NHibernate at runtime (Cuyahoga.NHibernateDriver). System.Data.SqlClient keeps
    NHibernate.Driver.SqlClientDriver and the existing connection strings working unchanged.
    -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- The install scripts of Cuyahoga.Core and the built-in modules. -->
    <Content Include="Install\**\*.sql" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
  The files of the modules (install scripts, e-mail templates, images) are deployed into Modules by the builds of the
  modules, after this project file is read: add them when publishing.
  -->
  <Target Name="IncludeCuyahogaModuleFiles" BeforeTargets="GetCopyToPublishDirectoryItems">
    <ItemGroup>
      <_CuyahogaModuleFile Include="Modules\**\*" />
      <ResolvedFileToPublish Include="@(_CuyahogaModuleFile->'%(FullPath)')"
                             RelativePath="Modules\%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
