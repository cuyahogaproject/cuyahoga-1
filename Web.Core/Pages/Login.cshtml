@page "/Login.aspx"
@model Cuyahoga.Web.Core.Pages.LoginModel
@{
	Layout = null;
}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" >
<html>
	<head>
		<title>Login</title>
		<link rel="stylesheet" type="text/css" href="@Url.Content("~/Admin/Css/Admin.css")">
	</head>
	<body>

		<form id="Form1" method="post">
			<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
			<div id="login">
				<h3>Cuyahoga login</h3>
				<table width="100%">
					<tr>
						<td></td>
						<td>@if (Model.Error != null) {<span id="lblError" class="validator">@Model.Error</span>}</td></tr>
					<tr>
						<td style="width:90px">User</td>
						<td><input name="username" type="text" id="txtUsername" style="width:140px;" /></td>
					</tr>
					<tr>
						<td>Password</td>
						<td><input name="password" type="password" id="txtPassword" style="width:140px;" /></td>
					</tr>
					<tr>
						<td></td>
						<td><input type="submit" name="btnLogin" value="Login" id="btnLogin" /></td>
					</tr>
				</table>
			</div>
		</form>

	</body>
</html>
