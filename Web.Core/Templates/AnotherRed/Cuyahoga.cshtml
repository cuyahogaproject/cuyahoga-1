<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
	<title>@Model.Page.Title</title>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<cuyahoga-head-assets />
</head>
<body>
	<div id="container">
		<div id="header">
			<div id="searcharea"><cuyahoga-placeholder id="searchinput" /></div>
			<div>
				<span id="titletext">Cuyahoga</span>
				A .NET Web Site Framework
			</div>
		</div>

		<!-- shadow divs -->
		<div id="containerleft">
		<div id="containertopleft">
		<div id="containerright">
		<div id="containertopright">
		<!-- main -->
		<div id="main">
			<div id="globalmenu">
				<cuyahoga-placeholder id="globalMenu" />
			</div>
			<div id="side">
				<div id="nav">
					<vc:hierarchical-menu />
				</div>
				<div id="sidecontent">
					<cuyahoga-placeholder id="side1content" />
				</div>
			</div>
			<div id="content">
				<cuyahoga-placeholder id="maincontent" />
			</div>
			<div class="clear"></div>
		</div>
		<!-- end main -->
		</div>
		</div>
		</div>
		</div>
		<!-- end shadow divs -->
	</div>
</body>
</html>
