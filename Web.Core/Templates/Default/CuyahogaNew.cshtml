<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
	<title>@Model.Page.Title</title>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<cuyahoga-head-assets />
</head>
<body>
		<div id="container">
			<div id="side">
				<div id="headerside">
					<span id="title">Cuyahoga</span>
				</div>
				<div id="nav">
					<vc:hierarchical-menu />
				</div>
				<div id="sidecontent">
					<cuyahoga-placeholder id="side1content" />
				</div>
			</div>
			<div id="main">
				<div id="headermain">
					<div id="subtitle">A .NET Website Framework</div>
					<div id="globalmenu">
						<cuyahoga-placeholder id="globalMenu" />
					</div>
				</div>
				<div id="content">
					<cuyahoga-placeholder id="maincontent" />
				</div>
			</div>
			<div id="footer"></div>
		</div>
</body>
</html>
