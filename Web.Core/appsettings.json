{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The url of the WebForms site (Web). Requests that this site doesn't handle are forwarded to it.
  "LegacySiteUrl": "",
  // The folder of the WebForms site (absolute, or relative to this site), for its search index and files.
  "LegacySitePath": "",

  // The same settings as the appSettings of the WebForms site (Web.config), without the "Cuyahoga." prefix, for
  // example "SmtpHost". Both sites must use the same database. The CUYAHOGA_* environment variables (for example
  // CUYAHOGA_CONNECTIONSTRING) override them, like they do for the WebForms site. Put a connection string with a
  // password in appsettings.local.json.
  "Cuyahoga": {
    "ConnectionString": "Server=(local);Database=Cuyahoga;Integrated Security=SSPI",
    "NHibernateDriver": "NHibernate.Driver.SqlClientDriver",
    "NHibernateDialect": "NHibernate.Dialect.MsSql2005Dialect",
    // sitemap.xml. Priority: 0.0 - 1.0. Frequency: always, hourly, daily, weekly, monthly, yearly, never.
    "SitemapDefaultPagePriority": "0.6",
    "SitemapDefaultPageUpdateFrequency": "daily"
  }
}
