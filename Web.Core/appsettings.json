{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The data of the site (absolute, or relative to the site): the files of the Downloads module (files), the search
  // index (index) and the files of the editor (UserFiles, served at /UserFiles).
  "DataPath": "App_Data",

  // The settings of Cuyahoga (the former appSettings of Web.config, without the "Cuyahoga." prefix), for example
  // "SmtpHost". The CUYAHOGA_* environment variables (for example CUYAHOGA_CONNECTIONSTRING) override them. Put a
  // connection string with a password in appsettings.local.json.
  "Cuyahoga": {
    "ConnectionString": "Server=(local);Database=Cuyahoga;Integrated Security=SSPI",
    "NHibernateDriver": "NHibernate.Driver.SqlClientDriver",
    "NHibernateDialect": "NHibernate.Dialect.MsSql2005Dialect",
    // sitemap.xml. Priority: 0.0 - 1.0. Frequency: always, hourly, daily, weekly, monthly, yearly, never.
    "SitemapDefaultPagePriority": "0.6",
    "SitemapDefaultPageUpdateFrequency": "daily"
  }
}
