<Project Sdk="Microsoft.NET.Sdk">
  <!--
  What the public pages of the ASP.NET Core site (Web.Core) offer to modules: the page that is being rendered, the base
  class for module views, page assets (stylesheets, scripts, meta tags) and urls. Module view projects (like
  Cuyahoga.Modules.Mvc) reference this project instead of the site itself.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cuyahoga.Web.Mvc</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Cuyahoga.Core.csproj" />
  </ItemGroup>
</Project>
