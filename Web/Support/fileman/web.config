<?xml version="1.0"?>
<configuration>
	
	<system.web>	
		<authorization>
			<allow roles="Administrator,Editor"/>
			<deny users="*"/>
		</authorization>
	</system.web>
	
	<system.webServer>
		<staticContent>
			<remove fileExtension=".json"/>
			<mimeMap fileExtension=".json" mimeType="application/json"/>
		</staticContent>
	</system.webServer>
	
</configuration>