<?xml version="1.0" encoding="utf-8"?>
<configuration>
	
	<configSections>
		<section name="UrlMappings" type="Cuyahoga.Web.Components.UrlMappingsSectionHandler, Cuyahoga.Web" />
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
	</configSections>

	<!--
	Machine-specific settings (for example the connection string with a password) go in the optional,
	git-ignored Web.local.config next to this file, with the same keys:
	  <appSettings>
	    <add key="Cuyahoga.ConnectionString" value="..." />
	  </appSettings>
	Its values override the ones below. Restart the site after changing it.
	-->
	<appSettings file="Web.local.config">
		<!--
		The validators don't use jQuery unobtrusive validation. Without this setting, .NET 4.5+
		(httpRuntime targetFramework) requires a jQuery ScriptResourceMapping.
		-->
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />

		<!--
		Database. The account that connects to the database for the first time needs permissions to create the tables.
		PostgreSQL (Npgsql): NHibernate.Driver.NpgsqlDriver and NHibernate.Dialect.PostgreSQL83Dialect,
		  connection string: Host=localhost;Port=5432;Database=cuyahoga;Username=...;Password=...
		MySQL (MySqlConnector): Cuyahoga.Core.Persistence.MySqlConnectorDriver, Cuyahoga.Core and
		  NHibernate.Dialect.MySQL55Dialect (the Cuyahoga tables store timestamps in whole seconds; newer MySQL
		  dialects assume fractional seconds). The install scripts use user variables:
		  connection string: Server=localhost;Port=3306;Database=cuyahoga;User ID=...;Password=...;Allow User Variables=true
		-->
		<add key="Cuyahoga.ConnectionString" value="Server=(local);Database=Cuyahoga;Integrated Security=SSPI" />
		<add key="Cuyahoga.NHibernateDriver" value="NHibernate.Driver.SqlClientDriver" />
		<add key="Cuyahoga.NHibernateDialect" value="NHibernate.Dialect.MsSql2005Dialect" />

		<!-- Email. Port, username, password and encoding (iso-8859-1, utf-8, ...) are optional. -->
		<add key="Cuyahoga.SmtpHost" value="localhost" />
		<add key="Cuyahoga.SmtpPort" value="" />
		<add key="Cuyahoga.SmtpUsername" value="" />
		<add key="Cuyahoga.SmtpPassword" value="" />
		<add key="Cuyahoga.EmailEncoding" value="" />

		<!-- Directory for temporary files of transactional uploads. Empty: the TEMP directory. -->
		<add key="Cuyahoga.TempDir" value="" />

		<!-- Site -->
		<add key="Cuyahoga.TemplateDir" value="~/Templates" />
		<!-- The administrator account that can't be deleted or lose the administrator role. -->
		<add key="Cuyahoga.SuperUser" value="admin" />
		<add key="Cuyahoga.AdministratorRole" value="Administrator" />
		<!-- true/false, customErrors must be enabled. -->
		<add key="Cuyahoga.RedirectToLoginWhenAccessDenied" value="true" />

		<!-- Search -->
		<add key="Cuyahoga.SearchIndexDir" value="~/index" />
		<!-- true/false: update the search index immediately when content changes. -->
		<add key="Cuyahoga.InstantIndexing" value="true" />

		<!-- sitemap.xml. Priority: 0.0 - 1.0. Frequency: always, hourly, daily, weekly, monthly, yearly, never. -->
		<add key="Cuyahoga.SitemapDefaultPagePriority" value="0.6" />
		<add key="Cuyahoga.SitemapDefaultPageUpdateFrequency" value="daily" />
	</appSettings>

	<UrlMappings>
		<add match="(Default.aspx|Login.aspx|Rss.aspx|Error.aspx|Profile.aspx?|Modules?|Admin?|Support?|Install?)" replace="" />
		<add match="(\d+)\/view.aspx([\w|/]*)\??(.*)" replace="Default.aspx$2?NodeId=$1&amp;$3" />
		<add match="(\d+)\/section.aspx([\w|/]*)\??(.*)" replace="Default.aspx$2?SectionId=$1&amp;$3" />
		<add match="(\d+)\/feed.aspx(.*)" replace="Rss.aspx$2?SectionId=$1" />
		<add match="(\d+)\/(\d+)\/view.aspx([\w|/]*)\??(.*)" replace="Default.aspx$3?NodeId=$1&amp;SectionId=$2&amp;$4" />
		<add match="([\w|\/|-]+).aspx([\w|/]*)\??(.*)" replace="Default.aspx$2?ShortDescription=$1&amp;$3" />
	</UrlMappings>

	
	<system.web>
		<httpHandlers>
			<add verb="*" path="sitemap.aspx" type="Cuyahoga.Web.HttpHandlers.SitemapHandler" />
			<add verb="*" path="sitemap.xml" type="Cuyahoga.Web.HttpHandlers.SitemapHandler" />
			<add verb="*" path="Error.aspx" type="System.Web.UI.PageHandlerFactory" />
			<add verb="*" path="*.aspx*" type="Cuyahoga.Web.HttpHandlers.PageHandler, Cuyahoga.Web" />
		</httpHandlers>
		<httpModules>
			<add type="Cuyahoga.Web.HttpModules.AuthenticationModule, Cuyahoga.Web" name="AuthenticationModule" />
			<add type="Cuyahoga.Web.HttpModules.CoreRepositoryModule, Cuyahoga.Web" name="CoreRepositoryModule" />
			<add name="NHibernateSessionModule" type="Cuyahoga.Web.HttpModules.NHibernateSessionModule, Cuyahoga.Web" />
		</httpModules>
		<!--
		targetFramework="4.8" enables the current ASP.NET behavior (e.g. cryptography). requestValidationMode stays
		at 2.0, because the editor pages and the admin section disable request validation with validateRequest="false".
		-->
		<httpRuntime targetFramework="4.8" executionTimeout="90" maxRequestLength="4000" requestValidationMode="2.0" enableVersionHeader="false" />
		<httpCookies httpOnlyCookies="true" />
		<compilation defaultLanguage="c#" debug="true" targetFramework="4.8" />
		<customErrors mode="RemoteOnly" />
		<authentication mode="Forms">
			<forms name="CuyahogaUser" loginUrl="Login.aspx" protection="All" timeout="30" path="/" />
		</authentication>
		<authorization>
			<allow users="*" />
		</authorization>
		<sessionState mode="InProc" cookieless="false" timeout="20" />
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" />
		<pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" />
	</system.web>

	<system.webServer>
		<validation validateIntegratedModeConfiguration="false" />
		<modules>
			<add type="Cuyahoga.Web.HttpModules.AuthenticationModule, Cuyahoga.Web" name="AuthenticationModule" />
			<add type="Cuyahoga.Web.HttpModules.CoreRepositoryModule, Cuyahoga.Web" name="CoreRepositoryModule" />
			<add name="NHibernateSessionModule" type="Cuyahoga.Web.HttpModules.NHibernateSessionModule, Cuyahoga.Web" />
		</modules>
		<handlers>
			<add name="Sitemap" verb="*" path="sitemap.*" type="Cuyahoga.Web.HttpHandlers.SitemapHandler" />
			<add name="ErrorHandler" verb="*" path="Error.aspx" type="System.Web.UI.PageHandlerFactory" />
			<add name="PageHandler" verb="*" path="*.aspx*" type="Cuyahoga.Web.HttpHandlers.PageHandler, Cuyahoga.Web" />
		</handlers>
		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>

	<!--
	Files uploaded to these directories are served through code (with permission checks).
	Never serve or execute them directly.
	-->
	<location path="files">
		<system.webServer>
			<handlers>
				<clear />
				<add name="Forbidden" path="*" verb="*" type="System.Web.HttpForbiddenHandler" />
			</handlers>
		</system.webServer>
	</location>
	<!-- Files uploaded through the file manager are served as static content only, never executed. -->
	<location path="UserFiles">
		<system.webServer>
			<handlers>
				<clear />
				<add name="StaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
			</handlers>
		</system.webServer>
	</location>

	<log4net debug="false">
		<appender name="rollingFile" type="log4net.Appender.RollingFileAppender,log4net">
			<param name="File" value="log/log.txt" />
			<param name="AppendToFile" value="true" />
			<param name="RollingStyle" value="Date" />
			<param name="DatePattern" value="yyyy.MM.dd" />
			<param name="StaticLogFileName" value="true" />
			<param name="CountDirection" value="1" />
			<layout type="log4net.Layout.PatternLayout,log4net">
				<param name="ConversionPattern" value="%d [%t] %-5p %c [%x] &lt;%X{auth}&gt; - %m%n" />
			</layout>
		</appender>
		<!--
		<root>
			<priority value="ERROR" />
			<appender-ref ref="rollingFile" />
		</root>

		<logger name="Cuyahoga.Web.HttpHandlers.PageHandler">
			<level value="INFO" />
		</logger>

		<logger name="Cuyahoga.Web.Global">
			<level value="DEBUG" />
		</logger>

		<logger name="Cuyahoga.Web.Components.ModuleLoader">
			<level value="DEBUG" />
		</logger>

		<logger name="NHibernate.SQL">
			<level value="INFO" />
		</logger>
		-->
	</log4net>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Castle.Core" publicKeyToken="407dd0808d44fbdc" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="NHibernate" publicKeyToken="aa95f207798dfdb4" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.5.0.0" newVersion="5.5.0.0" />
			</dependentAssembly>
			<!-- Dependencies of Lucene.Net and the database drivers (versions as in bin). -->
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Configuration.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.2" newVersion="8.0.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Primitives" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.1" newVersion="8.0.0.1" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.5" newVersion="8.0.0.5" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>