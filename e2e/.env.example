# Optional local settings for the e2e tests. Copy to .env (git-ignored).
# Every run creates an empty database, installs Cuyahoga with the web installer and tests it.

# Database type: mssql (LocalDB). mysql and postgres follow.
CUYAHOGA_E2E_DB=mssql
# SQL Server instance for mssql (default: LocalDB).
# CUYAHOGA_E2E_MSSQL_SERVER=(localdb)\MSSQLLocalDB
# Name of the test database (dropped and created on every run).
# CUYAHOGA_E2E_DATABASE_NAME=Cuyahoga_e2e
# Port of the test site (the development site uses 8080).
# CUYAHOGA_E2E_PORT=8081
