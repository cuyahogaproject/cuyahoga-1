# Optional local settings for the e2e tests. Copy to .env (git-ignored).
# Every run creates an empty database, installs Cuyahoga with the web installer and tests it.
# npm run test:mssql / test:mysql / test:postgres / test:all select the database type.

# Database type for 'npx playwright test': mssql (default), mysql or postgres.
# CUYAHOGA_E2E_DB=mssql
# Name of the test database (dropped and created on every run).
# CUYAHOGA_E2E_DATABASE_NAME=cuyahoga_e2e
# Port of the test site (the development site uses 8080).
# CUYAHOGA_E2E_PORT=8081

# SQL Server instance (default: LocalDB).
# CUYAHOGA_E2E_MSSQL_SERVER=(localdb)\MSSQLLocalDB

# MySQL and PostgreSQL: the user needs permission to create and drop databases.
CUYAHOGA_E2E_MYSQL_HOST=localhost
CUYAHOGA_E2E_MYSQL_PORT=3306
CUYAHOGA_E2E_MYSQL_USER=cuyahoga
CUYAHOGA_E2E_MYSQL_PASSWORD=

CUYAHOGA_E2E_POSTGRES_HOST=localhost
CUYAHOGA_E2E_POSTGRES_PORT=5432
CUYAHOGA_E2E_POSTGRES_USER=cuyahoga
CUYAHOGA_E2E_POSTGRES_PASSWORD=
